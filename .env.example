LOCAL_MODEL_RAW_ROOT=D:\\workspace\\rag-demo\\.local-models\\raw
LOCAL_ONNX_WASM_ROOT=D:\\workspace\\rag-demo\\node_modules\\onnxruntime-web\\dist

# Optional:
# LOCAL_MODEL_INCLUDE_RERANK=1
# LOCAL_EMBEDDING_MODEL_REVISION=main
# LOCAL_RERANK_MODEL_REVISION=main
#
# CI only:
# LOCAL_MODEL_ALLOW_NETWORK=1
# HF_TOKEN=your_huggingface_token

# Local development service ports
# UI_CHAT_BACKEND_PORT=8788
# UI_CHAT_DESKTOP_PORT=5174
# UI_CHAT_DOCS_SITE_PORT=4181

# GitHub micro-app defaults (optional; can also be configured in the UI)
# UI_CHAT_GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# UI_CHAT_GITHUB_APP_SLUG=uichat-mira

# Browser extension CRX signing key (optional; required for extension packaging)
# MIRA_CLIPPER_CRX_KEY_PATH=D:/path/to/mira-clipper-dev.pem
